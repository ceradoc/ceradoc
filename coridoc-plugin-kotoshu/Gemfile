gemspec

# Local dev: use in-tree source when present.
kotoshu_path = File.expand_path('../../../kotoshu/kotoshu', __dir__)
gem 'kotoshu', path: kotoshu_path if File.directory?(kotoshu_path)

coridoc_path = File.expand_path('../../coridoc', __dir__)
coridoc_adoc_path = File.expand_path('../../coridoc-adoc', __dir__)
if File.directory?(coridoc_path)
  gem 'coridoc', path: coridoc_path
  gem 'coridoc-adoc', path: coridoc_adoc_path if File.directory?(coridoc_adoc_path)
end

gem 'pry', '~> 0.14', group: :development
