DOC\ndoc = Ceradoc.parse(input)\noutput = doc.to_adoc\nputs \"Serialized output:\"\nputs output","lines":["require 'ceradoc'","input = <<~ASCIIDOC","  = Document Title","  == Section 1","  This is a paragraph.","ASCIIDOC","doc = Ceradoc.parse(input)","output = doc.to_adoc","puts \"Serialized output:\"","puts output"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_1_basic_serialization_what_it_does","title":"What It Does","source_line":46,"level":2,"children":[{"type":"ListBlock","source_line":48,"marker_type":"ordered","items":[{"type":"ListItem","source_line":48,"children":[{"type":"TextContent","text":"Parses an AsciiDoc document"}],"marker":"1.","content":"Parses an AsciiDoc document"},{"type":"ListItem","source_line":49,"children":[{"type":"TextContent","text":"Serializes it back to AsciiDoc"}],"marker":"2.","content":"Serializes it back to AsciiDoc"},{"type":"ListItem","source_line":50,"children":[{"type":"TextContent","text":"Prints the result"}],"marker":"3.","content":"Prints the result"}]}]},{"type":"SectionElement","id":"_example_1_basic_serialization_expected_output","title":"Expected Output","source_line":52,"level":2,"children":[{"type":"SourceBlock","source_line":54,"children":[],"content":"Serialized output:\n= Document Title\n== Section 1\nThis is a paragraph","lines":["Serialized output:","= Document Title","== Section 1","This is a paragraph"],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_2_serialize_individual_elements","title":"Example 2: Serialize Individual Elements","source_line":63,"level":1,"children":[{"type":"SectionElement","id":"_example_2_serialize_individual_elements_the_code","title":"The Code","source_line":65,"level":2,"children":[{"type":"SourceBlock","source_line":67,"children":[],"content":"require 'ceradoc'\n# Serialize a paragraph\nparagraph = Ceradoc::Model::Paragraph.new\nparagraph.content = [\n  Ceradoc::Model::TextElement.new(\"This is a paragraph with \"),\n  Ceradoc::Model::Inline::Bold.new(content: \"bold text\"),\n]\nputs \"Paragraph:\"\nputs paragraph.to_adoc\nputs\n# Serialize a section\nsection = Ceradoc::Model::Section.new\nsection.title = Ceradoc::Model::Title.new\nsection.title.level_int = 2\nsection.title.content = [\"Custom Section\"]\npara = Ceradoc::Model::Paragraph.new\npara.content = [Ceradoc::Model::TextElement.new(\"Section content\")]\nsection.blocks = [para]\nputs \"Section:\"\nputs section.to_adoc","lines":["require 'ceradoc'","# Serialize a paragraph","paragraph = Ceradoc::Model::Paragraph.new","paragraph.content = [","  Ceradoc::Model::TextElement.new(\"This is a paragraph with \"),","  Ceradoc::Model::Inline::Bold.new(content: \"bold text\"),","]","puts \"Paragraph:\"","puts paragraph.to_adoc","puts","# Serialize a section","section = Ceradoc::Model::Section.new","section.title = Ceradoc::Model::Title.new","section.title.level_int = 2","section.title.content = [\"Custom Section\"]","para = Ceradoc::Model::Paragraph.new","para.content = [Ceradoc::Model::TextElement.new(\"Section content\")]","section.blocks = [para]","puts \"Section:\"","puts section.to_adoc"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_2_serialize_individual_elements_what_it_does","title":"What It Does","source_line":93,"level":2,"children":[{"type":"ListBlock","source_line":95,"marker_type":"ordered","items":[{"type":"ListItem","source_line":95,"children":[{"type":"TextContent","text":"Creates a paragraph model with inline elements"}],"marker":"1.","content":"Creates a paragraph model with inline elements"},{"type":"ListItem","source_line":96,"children":[{"type":"TextContent","text":"Serializes the paragraph"}],"marker":"2.","content":"Serializes the paragraph"},{"type":"ListItem","source_line":97,"children":[{"type":"TextContent","text":"Creates a section model with content"}],"marker":"3.","content":"Creates a section model with content"},{"type":"ListItem","source_line":98,"children":[{"type":"TextContent","text":"Serializes the section"}],"marker":"4.","content":"Serializes the section"}]}]},{"type":"SectionElement","id":"_example_2_serialize_individual_elements_expected_output","title":"Expected Output","source_line":100,"level":2,"children":[{"type":"SourceBlock","source_line":102,"children":[],"content":"Paragraph:\nThis is a paragraph with *bold text*\nSection:\n== Custom Section\nSection content","lines":["Paragraph:","This is a paragraph with *bold text*","Section:","== Custom Section","Section content"],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_3_serialize_lists","title":"Example 3: Serialize Lists","source_line":112,"level":1,"children":[{"type":"SectionElement","id":"_example_3_serialize_lists_the_code","title":"The Code","source_line":114,"level":2,"children":[{"type":"SourceBlock","source_line":116,"children":[],"content":"require 'ceradoc'\n# Unordered list\nlist = Ceradoc::Model::List::Unordered.new\nitem1 = Ceradoc::Model::ListItem.new\nitem1.content = [Ceradoc::Model::TextElement.new(\"First item\")]\nlist.items << item1\nitem2 = Ceradoc::Model::ListItem.new\nitem2.content = [Ceradoc::Model::TextElement.new(\"Second item\")]\nlist.items << item2\nputs \"Unordered list:\"\nputs list.to_adoc\nputs\n# Ordered list\nordered = Ceradoc::Model::List::Ordered.new\nitem = Ceradoc::Model::ListItem.new\nitem.content = [Ceradoc::Model::TextElement.new(\"Step one\")]\nordered.items << item\nitem = Ceradoc::Model::ListItem.new\nitem.content = [Ceradoc::Model::TextElement.new(\"Step two\")]\nordered.items << item\nputs \"Ordered list:\"\nputs ordered.to_adoc","lines":["require 'ceradoc'","# Unordered list","list = Ceradoc::Model::List::Unordered.new","item1 = Ceradoc::Model::ListItem.new","item1.content = [Ceradoc::Model::TextElement.new(\"First item\")]","list.items << item1","item2 = Ceradoc::Model::ListItem.new","item2.content = [Ceradoc::Model::TextElement.new(\"Second item\")]","list.items << item2","puts \"Unordered list:\"","puts list.to_adoc","puts","# Ordered list","ordered = Ceradoc::Model::List::Ordered.new","item = Ceradoc::Model::ListItem.new","item.content = [Ceradoc::Model::TextElement.new(\"Step one\")]","ordered.items << item","item = Ceradoc::Model::ListItem.new","item.content = [Ceradoc::Model::TextElement.new(\"Step two\")]","ordered.items << item","puts \"Ordered list:\"","puts ordered.to_adoc"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_3_serialize_lists_what_it_does","title":"What It Does","source_line":148,"level":2,"children":[{"type":"ListBlock","source_line":150,"marker_type":"ordered","items":[{"type":"ListItem","source_line":150,"children":[{"type":"TextContent","text":"Creates an unordered list model"}],"marker":"1.","content":"Creates an unordered list model"},{"type":"ListItem","source_line":151,"children":[{"type":"TextContent","text":"Serializes the unordered list"}],"marker":"2.","content":"Serializes the unordered list"},{"type":"ListItem","source_line":152,"children":[{"type":"TextContent","text":"Creates an ordered list model"}],"marker":"3.","content":"Creates an ordered list model"},{"type":"ListItem","source_line":153,"children":[{"type":"TextContent","text":"Serializes the ordered list"}],"marker":"4.","content":"Serializes the ordered list"}]}]},{"type":"SectionElement","id":"_example_3_serialize_lists_expected_output","title":"Expected Output","source_line":155,"level":2,"children":[{"type":"SourceBlock","source_line":157,"children":[],"content":"Unordered list:\n* First item\n* Second item\nOrdered list:\n. Step one\n. Step two","lines":["Unordered list:","* First item","* Second item","Ordered list:",". Step one",". Step two"],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_4_serialize_tables","title":"Example 4: Serialize Tables","source_line":167,"level":1,"children":[{"type":"SectionElement","id":"_example_4_serialize_tables_the_code","title":"The Code","source_line":169,"level":2,"children":[{"type":"SourceBlock","source_line":171,"children":[],"content":"require 'ceradoc'\ntable = Ceradoc::Model::Table.new\n# Add header row\nheader_row = Ceradoc::Model::TableRow.new\n%w[Name Age City].each do |header_text|\n  cell = Ceradoc::Model::TableCell.new\n  cell.content = [Ceradoc::Model::TextElement.new(header_text)]\n  header_row.columns << cell\nend\ntable.rows << header_row\n# Add data row\ndata_row = Ceradoc::Model::TableRow.new\n%w[Alice 25 NYC].each do |cell_text|\n  cell = Ceradoc::Model::TableCell.new\n  cell.content = [Ceradoc::Model::TextElement.new(cell_text)]\n  data_row.columns << cell\nend\ntable.rows << data_row\nputs \"Table:\"\nputs table.to_adoc","lines":["require 'ceradoc'","table = Ceradoc::Model::Table.new","# Add header row","header_row = Ceradoc::Model::TableRow.new","%w[Name Age City].each do |header_text|","  cell = Ceradoc::Model::TableCell.new","  cell.content = [Ceradoc::Model::TextElement.new(header_text)]","  header_row.columns << cell","end","table.rows << header_row","# Add data row","data_row = Ceradoc::Model::TableRow.new","%w[Alice 25 NYC].each do |cell_text|","  cell = Ceradoc::Model::TableCell.new","  cell.content = [Ceradoc::Model::TextElement.new(cell_text)]","  data_row.columns << cell","end","table.rows << data_row","puts \"Table:\"","puts table.to_adoc"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_4_serialize_tables_what_it_does","title":"What It Does","source_line":199,"level":2,"children":[{"type":"ListBlock","source_line":201,"marker_type":"ordered","items":[{"type":"ListItem","source_line":201,"children":[{"type":"TextContent","text":"Creates a table model"}],"marker":"1.","content":"Creates a table model"},{"type":"ListItem","source_line":202,"children":[{"type":"TextContent","text":"Adds a header row with cells"}],"marker":"2.","content":"Adds a header row with cells"},{"type":"ListItem","source_line":203,"children":[{"type":"TextContent","text":"Adds a data row with cells"}],"marker":"3.","content":"Adds a data row with cells"},{"type":"ListItem","source_line":204,"children":[{"type":"TextContent","text":"Serializes the table"}],"marker":"4.","content":"Serializes the table"}]}]},{"type":"SectionElement","id":"_example_4_serialize_tables_expected_output","title":"Expected Output","source_line":206,"level":2,"children":[{"type":"SourceBlock","source_line":208,"children":[],"content":"Table:\n|===\n|Name |Age |City\n|Alice |25 |NYC\n|===","lines":["Table:","|===","|Name |Age |City","|Alice |25 |NYC","|==="],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_5_serialize_blocks","title":"Example 5: Serialize Blocks","source_line":217,"level":1,"children":[{"type":"SectionElement","id":"_example_5_serialize_blocks_the_code","title":"The Code","source_line":219,"level":2,"children":[{"type":"SourceBlock","source_line":221,"children":[],"content":"require 'ceradoc'\n# Listing block\nlisting = Ceradoc::Model::Block::Listing.new\nlisting.lines = [\"def hello\", \"  puts 'Hello, World!'\", \"end\"]\nlisting.attributes = Ceradoc::Model::AttributeList.new\nlisting.attributes.add_positional(\"ruby\")\nputs \"Listing block:\"\nputs listing.to_adoc\nputs\n# Quote block\nquote = Ceradoc::Model::Block::Quote.new\nquote.lines = [\"This is a quote.\", \"It spans multiple lines.\"]\nputs \"Quote block:\"\nputs quote.to_adoc","lines":["require 'ceradoc'","# Listing block","listing = Ceradoc::Model::Block::Listing.new","listing.lines = [\"def hello\", \"  puts 'Hello, World!'\", \"end\"]","listing.attributes = Ceradoc::Model::AttributeList.new","listing.attributes.add_positional(\"ruby\")","puts \"Listing block:\"","puts listing.to_adoc","puts","# Quote block","quote = Ceradoc::Model::Block::Quote.new","quote.lines = [\"This is a quote.\", \"It spans multiple lines.\"]","puts \"Quote block:\"","puts quote.to_adoc"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_5_serialize_blocks_what_it_does","title":"What It Does","source_line":241,"level":2,"children":[{"type":"ListBlock","source_line":243,"marker_type":"ordered","items":[{"type":"ListItem","source_line":243,"children":[{"type":"TextContent","text":"Creates a listing block with attributes"}],"marker":"1.","content":"Creates a listing block with attributes"},{"type":"ListItem","source_line":244,"children":[{"type":"TextContent","text":"Serializes the listing block"}],"marker":"2.","content":"Serializes the listing block"},{"type":"ListItem","source_line":245,"children":[{"type":"TextContent","text":"Creates a quote block"}],"marker":"3.","content":"Creates a quote block"},{"type":"ListItem","source_line":246,"children":[{"type":"TextContent","text":"Serializes the quote block"}],"marker":"4.","content":"Serializes the quote block"}]}]},{"type":"SectionElement","id":"_example_5_serialize_blocks_expected_output","title":"Expected Output","source_line":248,"level":2,"children":[{"type":"SourceBlock","source_line":250,"children":[],"content":"Listing block:\n[source,ruby]","lines":["Listing block:","[source,ruby]"],"callouts":[]},{"type":"ParagraphBlock","source_line":254,"children":[{"type":"TextContent","text":"def hello   puts 'Hello, World!' end"}],"content":"def hello   puts 'Hello, World!' end","lines":["def hello   puts 'Hello, World!' end"],"callouts":[]},{"type":"SourceBlock","source_line":257,"children":[],"content":"Quote block:\n____\nThis is a quote.\nIt spans multiple lines.\n____","lines":["Quote block:","____","This is a quote.","It spans multiple lines.","____"],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_6_serialize_inline_elements","title":"Example 6: Serialize Inline Elements","source_line":266,"level":1,"children":[{"type":"SectionElement","id":"_example_6_serialize_inline_elements_the_code","title":"The Code","source_line":268,"level":2,"children":[{"type":"SourceBlock","source_line":270,"children":[],"content":"require 'ceradoc'\n# Create paragraph with various inline elements\nparagraph = Ceradoc::Model::Paragraph.new\nparagraph.content = [\n  Ceradoc::Model::TextElement.new(\"Text with \"),\n  Ceradoc::Model::Inline::Bold.new(content: \"bold\"),\n  Ceradoc::Model::TextElement.new(\", \"),\n  Ceradoc::Model::Inline::Italic.new(content: \"italic\"),\n  Ceradoc::Model::TextElement.new(\", and \"),\n  Ceradoc::Model::Inline::Monospace.new(content: \"monospace\"),\n  Ceradoc::Model::TextElement.new(\" text.\"),\n]\nputs \"Paragraph with inline elements:\"\nputs paragraph.to_adoc\nputs\n# Link\nlink = Ceradoc::Model::Inline::Link.new\nlink.path = \"https://example.com\"\nlink.name = \"Example Site\"\nputs \"Link:\"\nputs \"#{link.to_adoc}\\n\"\nputs\n# Anchor\nanchor = Ceradoc::Model::Inline::Anchor.new\nanchor.id = \"section1\"\nputs \"Anchor:\"\nputs \"#{anchor.to_adoc}\\n\"","lines":["require 'ceradoc'","# Create paragraph with various inline elements","paragraph = Ceradoc::Model::Paragraph.new","paragraph.content = [","  Ceradoc::Model::TextElement.new(\"Text with \"),","  Ceradoc::Model::Inline::Bold.new(content: \"bold\"),","  Ceradoc::Model::TextElement.new(\", \"),","  Ceradoc::Model::Inline::Italic.new(content: \"italic\"),","  Ceradoc::Model::TextElement.new(\", and \"),","  Ceradoc::Model::Inline::Monospace.new(content: \"monospace\"),","  Ceradoc::Model::TextElement.new(\" text.\"),","]","puts \"Paragraph with inline elements:\"","puts paragraph.to_adoc","puts","# Link","link = Ceradoc::Model::Inline::Link.new","link.path = \"https://example.com\"","link.name = \"Example Site\"","puts \"Link:\"","puts \"#{link.to_adoc}\\n\"","puts","# Anchor","anchor = Ceradoc::Model::Inline::Anchor.new","anchor.id = \"section1\"","puts \"Anchor:\"","puts \"#{anchor.to_adoc}\\n\""],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_6_serialize_inline_elements_what_it_does","title":"What It Does","source_line":305,"level":2,"children":[{"type":"ListBlock","source_line":307,"marker_type":"ordered","items":[{"type":"ListItem","source_line":307,"children":[{"type":"TextContent","text":"Creates a paragraph with multiple inline element types"}],"marker":"1.","content":"Creates a paragraph with multiple inline element types"},{"type":"ListItem","source_line":308,"children":[{"type":"TextContent","text":"Serializes each inline element type"}],"marker":"2.","content":"Serializes each inline element type"},{"type":"ListItem","source_line":309,"children":[{"type":"TextContent","text":"Creates and serializes a link"}],"marker":"3.","content":"Creates and serializes a link"},{"type":"ListItem","source_line":310,"children":[{"type":"TextContent","text":"Creates and serializes an anchor"}],"marker":"4.","content":"Creates and serializes an anchor"}]}]},{"type":"SectionElement","id":"_example_6_serialize_inline_elements_expected_output","title":"Expected Output","source_line":312,"level":2,"children":[{"type":"SourceBlock","source_line":314,"children":[],"content":"Paragraph with inline elements:\nText with *bold*, _italic_, and `monospace` text.\nLink:\nhttps://example.com[Example Site]\nAnchor:\n[[section1]]","lines":["Paragraph with inline elements:","Text with *bold*, _italic_, and `monospace` text.","Link:","https://example.com[Example Site]","Anchor:","[[section1]]"],"callouts":[]}]}]},{"type":"SectionElement","id":"_example_7_roundtrip_preservation","title":"Example 7: Round-Trip Preservation","source_line":325,"level":1,"children":[{"type":"SectionElement","id":"_example_7_roundtrip_preservation_the_code","title":"The Code","source_line":327,"level":2,"children":[{"type":"SourceBlock","source_line":329,"children":[],"content":"require 'ceradoc'\noriginal = <<~ASCIIDOC\n  = Document Title\n  == Section One\n  This is a paragraph with *bold* and _italic_ text.\n  * List item 1\n  * List item 2\nASCIIDOC\n# Parse\ndoc1 = Ceradoc.parse(original)\n# Serialize\nserialized = doc1.to_adoc\n# Parse again\ndoc2 = Ceradoc.parse(serialized)\nputs \"Original document title: #{doc1.header.title}\"\nputs \"Re-parsed document title: #{doc2.header.title}\"\n# Both should have the same structure\nputs \"Original sections: #{doc1.sections.size}\"\nputs \"Re-parsed sections: #{doc2.sections.size}\"\nputs \"\\nSerialized output:\"\nputs serialized","lines":["require 'ceradoc'","original = <<~ASCIIDOC","  = Document Title","  == Section One","  This is a paragraph with *bold* and _italic_ text.","  * List item 1","  * List item 2","ASCIIDOC","# Parse","doc1 = Ceradoc.parse(original)","# Serialize","serialized = doc1.to_adoc","# Parse again","doc2 = Ceradoc.parse(serialized)","puts \"Original document title: #{doc1.header.title}\"","puts \"Re-parsed document title: #{doc2.header.title}\"","# Both should have the same structure","puts \"Original sections: #{doc1.sections.size}\"","puts \"Re-parsed sections: #{doc2.sections.size}\"","puts \"\\nSerialized output:\"","puts serialized"],"language":"ruby","callouts":[]}]},{"type":"SectionElement","id":"_example_7_roundtrip_preservation_what_it_does","title":"What It Does","source_line":364,"level":2,"children":[{"type":"ListBlock","source_line":366,"marker_type":"ordered","items":[{"type":"ListItem","source_line":366,"children":[{"type":"TextContent","text":"Parses an original document"}],"marker":"1.","content":"Parses an original document"},{"type":"ListItem","source_line":367,"children":[{"type":"TextContent","text":"Serializes it to AsciiDoc"}],"marker":"2.","content":"Serializes it to AsciiDoc"},{"type":"ListItem","source_line":368,"children":[{"type":"TextContent","text":"Parses the serialized output again"}],"marker":"3.","content":"Parses the serialized output again"},{"type":"ListItem","source_line":369,"children":[{"type":"TextContent","text":"Compares the two models for semantic equivalence"}],"marker":"4.","content":"Compares the two models for semantic equivalence"}]}]},{"type":"SectionElement","id":"_example_7_roundtrip_preservation_expected_output","title":"Expected Output","source_line":371,"level":2,"children":[{"type":"SourceBlock","source_line":373,"children":[],"content":"Origin