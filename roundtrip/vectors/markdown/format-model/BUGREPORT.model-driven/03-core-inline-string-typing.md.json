concept)","children":[{"attributes":[],"text":"constrained"},{"attributes":[],"content":" attribute removed from "},{"attributes":[],"text":"InlineElement"},{"attributes":[],"content":" (AsciiDoc-only concept)"}]},{"attributes":[],"text":"Two divergent type lists consolidated into single canonical source on `InlineElement`","children":[{"attributes":[],"content":"Two divergent type lists consolidated into single canonical source on "},{"attributes":[],"text":"InlineElement"}]}]},{"attributes":[],"text":"**Severity:** HIGH  \n**Location:** `lib/ceradoc/core_model/inline_element.rb`, `lib/ceradoc/core_model/builder/detection.rb`","children":[{"attributes":[],"text":"Severity:"},{"attributes":[],"content":" HIGH  "},{"attributes":[],"content":"\n"},{"attributes":[],"text":"Location:"},{"attributes":[],"content":" "},{"attributes":[],"text":"lib/ceradoc/core_model/inline_element.rb"},{"attributes":[],"content":", "},{"attributes":[],"text":"lib/ceradoc/core_model/builder/detection.rb"}]},{"attributes":[],"level":2,"text":"Problem"},{"attributes":[],"text":"`CoreModel::InlineElement` uses a `format_type` string attribute (`'bold'`, `'italic'`, `'monospace'`) to distinguish inline types, while `Block` correctly uses typed subclasses (`SourceBlock < Block`, `QuoteBlock < Block`). This architectural inconsistency forces every consumer to use `case format_type` instead of polymorphic dispatch.","children":[{"attributes":[],"text":"CoreModel::InlineElement"},{"attributes":[],"content":" uses a "},{"attributes":[],"text":"format_type"},{"attributes":[],"content":" string attribute ("},{"attributes":[],"text":"'bold'"},{"attributes":[],"content":", "},{"attributes":[],"text":"'italic'"},{"attributes":[],"content":", "},{"attributes":[],"text":"'monospace'"},{"attributes":[],"content":") to distinguish inline types, while "},{"attributes":[],"text":"Block"},{"attributes":[],"content":" correctly uses typed subclasses ("},{"attributes":[],"text":"SourceBlock < Block"},{"attributes":[],"content":", "},{"attributes":[],"text":"QuoteBlock < Block"},{"attributes":[],"content":"). This architectural inconsistency forces every consumer to use "},{"attributes":[],"text":"case format_type"},{"attributes":[],"content":" instead of polymorphic dispatch."}]},{"attributes":[],"text":"Additionally, the `constrained` attribute on `InlineElement` is an AsciiDoc-only concept.","children":[{"attributes":[],"content":"Additionally, the "},{"attributes":[],"text":"constrained"},{"attributes":[],"content":" attribute on "},{"attributes":[],"text":"InlineElement"},{"attributes":[],"content":" is an AsciiDoc-only concept."}]},{"attributes":[],"level":2,"text":"Evidence"},{"attributes":[],"level":3,"text":"3A. String-based `format_type` with divergent type lists"},{"attributes":[],"text":"`lib/ceradoc/core_model/inline_element.rb:49-61`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/inline_element.rb:49-61"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"FORMAT_TYPES = %w[\n  bold italic monospace underline strikethrough\n  subscript superscript highlight\n  link xref stem footnote\n  hard_line_break\n].freeze\n\nattribute :format_type, :string"},{"attributes":[],"text":"The Builder's `Detection#inline_format_types` (`builder/detection.rb:178-183`) defines a DIFFERENT list:","children":[{"attributes":[],"content":"The Builder's "},{"attributes":[],"text":"Detection#inline_format_types"},{"attributes":[],"content":" ("},{"attributes":[],"text":"builder/detection.rb:178-183"},{"attributes":[],"content":") defines a DIFFERENT list:"}]},{"attributes":[],"language":"ruby","code":"%i[bold italic monospace superscript subscript highlight span link\n   cross_reference bold_constrained bold_unconstrained\n   italic_constrained italic_unconstrained monospace_constrained\n   monospace_unconstrained]"},{"attributes":[],"text":"Divergence:","children":[{"attributes":[],"content":"Divergence:"}]},{"attributes":[],"ordered":false,"items":[{"attributes":[],"text":"`FORMAT_TYPES` has: `underline`, `strikethrough`, `xref`, `stem`, `footnote`, `hard_line_break`","children":[{"attributes":[],"text":"FORMAT_TYPES"},{"attributes":[],"content":" has: "},{"attributes":[],"text":"underline"},{"attributes":[],"content":", "},{"attributes":[],"text":"strikethrough"},{"attributes":[],"content":", "},{"attributes":[],"text":"xref"},{"attributes":[],"content":", "},{"attributes":[],"text":"stem"},{"attributes":[],"content":", "},{"attributes":[],"text":"footnote"},{"attributes":[],"content":", "},{"attributes":[],"text":"hard_line_break"}]},{"attributes":[],"text":"`inline_format_types` has: `span`, `cross_reference`, `*_constrained`, `*_unconstrained`","children":[{"attributes":[],"text":"inline_format_types"},{"attributes":[],"content":" has: "},{"attributes":[],"text":"span"},{"attributes":[],"content":", "},{"attributes":[],"text":"cross_reference"},{"attributes":[],"content":", "},{"attributes":[],"text":"*_constrained"},{"attributes":[],"content":", "},{"attributes":[],"text":"*_unconstrained"}]},{"attributes":[],"text":"`xref` vs `cross_reference` — two names for the same concept","children":[{"attributes":[],"text":"xref"},{"attributes":[],"content":" vs "},{"attributes":[],"text":"cross_reference"},{"attributes":[],"content":" — two names for the same concept"}]},{"attributes":[],"text":"Strings vs symbols inconsistency","children":[{"attributes":[],"content":"Strings vs symbols inconsistency"}]}]},{"attributes":[],"level":3,"text":"3B. Cascading `case`/`when` chains in every transformer"},{"attributes":[],"ordered":false,"items":[{"attributes":[],"text":"`ceradoc-html/lib/ceradoc/html/converters/base.rb:109-152` — 20-case chain","children":[{"attributes":[],"text":"ceradoc-html/lib/ceradoc/html/converters/base.rb:109-152"},{"attributes":[],"content":" — 20-case chain"}]},{"attributes":[],"text":"`ceradoc-adoc/lib/ceradoc/asciidoc/transform/from_core_model.rb:225-260` — 15-case chain","children":[{"attributes":[],"text":"ceradoc-adoc/lib/ceradoc/asciidoc/transform/from_core_model.rb:225-260"},{"attributes":[],"content":" — 15-case chain"}]},{"attributes":[],"text":"`ceradoc-markdown/lib/ceradoc/markdown/transform/from_core_model.rb:172-206` — 15-case chain","children":[{"attributes":[],"text":"ceradoc-markdown/lib/ceradoc/markdown/transform/from_core_model.rb:172-206"},{"attributes":[],"content":" — 15-case chain"}]},{"attributes":[],"text":"`ceradoc-docx/lib/ceradoc/docx/transform/from_core_model.rb:43-57` — catches all InlineElement then re-dispatches","children":[{"attributes":[],"text":"ceradoc-docx/lib/ceradoc/docx/transform/from_core_model.rb:43-57"},{"attributes":[],"content":" — catches all InlineElement then re-dispatches"}]}]},{"attributes":[],"level":3,"text":"3C. `constrained` attribute — AsciiDoc-only concept"},{"attributes":[],"text":"`lib/ceradoc/core_model/inline_element.rb:63-66`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/inline_element.rb:63-66"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"# whether the formatting uses constrained syntax (true for *text*, false for **text**)\nattribute :constrained, :boolean, default: -> { true }"},{"attributes":[],"text":"Constrained/unconstrained is uniquely AsciiDoc. Markdown uses `*` vs `**` for italic vs bold — a different semantic. HTML has no such concept.","children":[{"attributes":[],"content":"Constrained/unconstrained is uniquely AsciiDoc. Markdown uses "},{"attributes":[],"text":"*"},{"attributes":[],"content":" vs "},{"attributes":[],"text":"**"},{"attributes":[],"content":" for italic vs bold — a different semantic. HTML has no such concept."}]},{"attributes":[],"level":3,"text":"3D. Builder detection of `_constrained`/`_unconstrained` AST keys"},{"attributes":[],"text":"`lib/ceradoc/core_model/builder/detection.rb:126-153`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/builder/detection.rb:126-153"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"def detect_inline_format(ast)\n  ast.each_key do |key|\n    key_str = key.to_s\n    return key_str if key_str.end_with?('_constrained', '_unconstrained')\n  end\nend\n\ndef detect_constrained(ast, format_type)\n  if format_type.end_with?('_constrained')\n    return true\n  elsif format_type.end_with?('_unconstrained')\n    return false\n  end\nend"},{"attributes":[],"text":"These AST key names are artifacts of the AsciiDoc parser's AST structure.","children":[{"attributes":[],"content":"These AST key names are artifacts of the AsciiDoc parser's AST structure."}]},{"attributes":[],"level":2,"text":"Fix"},{"attributes":[],"ordered":true,"items":[{"attributes":[],"text":"Create typed InlineElement subclasses matching the Block pattern: `BoldElement`, `ItalicElement`, `LinkElement`, etc.","children":[{"attributes":[],"content":"Create typed InlineElement subclasses matching the Block pattern: "},{"attributes":[],"text":"BoldElement"},{"attributes":[],"content":", "},{"attributes":[],"text":"ItalicElement"},{"attributes":[],"content":", "},{"attributes":[],"text":"LinkElement"},{"attributes":[],"content":", etc."}]},{"attributes":[],"text":"Move `constrained` to the AsciiDoc format gem's own inline model.","children":[{"attributes":[],"content":"Move "},{"attributes":[],"text":"constrained"},{"attributes":[],"content":" to the AsciiDoc format gem's own inline model."}]},{"attributes":[],"text":"Consolidate the two divergent type lists into a single canonical source.","children":[{"attributes":[],"content":"Consolidate the two divergent type lists into a single canonical source."}]},{"attributes":[],"text":"Transformers use class-based dispatch (`when Ceradoc::CoreModel::BoldElement`) instead of string matching.","children":[{"attributes":[],"content":"Transformers use class-based dispatch ("},{"attributes":[],"text":"when Ceradoc::CoreModel::BoldElement"},{"attributes":[],"content":") instead of string matching."}]}]}]}