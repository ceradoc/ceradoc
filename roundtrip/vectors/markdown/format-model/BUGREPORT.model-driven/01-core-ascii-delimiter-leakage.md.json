no place in the core.","children":[{"attributes":[],"content":"CoreModel is the format-neutral hub, yet it contains hardcoded AsciiDoc delimiter-to-semantics mappings in TWO places. The characters "},{"attributes":[],"text":"-"},{"attributes":[],"content":", "},{"attributes":[],"text":"="},{"attributes":[],"content":", "},{"attributes":[],"text":"_"},{"attributes":[],"content":", "},{"attributes":[],"text":"*"},{"attributes":[],"content":", "},{"attributes":[],"text":"."},{"attributes":[],"content":", "},{"attributes":[],"text":"+"},{"attributes":[],"content":" and the convention of 4-character delimiters are AsciiDoc-specific. Markdown uses fences (```), HTML uses tags ("},{"attributes":[],"text":"<pre>"},{"attributes":[],"content":", "},{"attributes":[],"text":"<blockquote>"},{"attributes":[],"content":"). This knowledge has no place in the core."}]},{"attributes":[],"level":2,"text":"Evidence"},{"attributes":[],"level":3,"text":"1A. `DELIMITER_CHAR_TO_SEMANTIC` constant"},{"attributes":[],"text":"`lib/ceradoc/core_model/block.rb:134-141`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/block.rb:134-141"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"DELIMITER_CHAR_TO_SEMANTIC = {\n  '-' => :source_code,\n  '=' => :example,\n  '_' => :quote,\n  '*' => :sidebar,\n  '.' => :literal,\n  '+' => :pass\n}.freeze"},{"attributes":[],"level":3,"text":"1B. `resolve_semantic_from_delimiter` method"},{"attributes":[],"text":"`lib/ceradoc/core_model/block.rb:125-131`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/block.rb:125-131"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"def resolve_semantic_from_delimiter\n  delim = delimiter_type\n  return nil unless delim && delim.length >= 4\n  char = delim[0]\n  DELIMITER_CHAR_TO_SEMANTIC[char] || nil\nend"},{"attributes":[],"text":"The assumption that delimiters are ≥4 chars and the first char determines the type is an AsciiDoc parsing rule.","children":[{"attributes":[],"content":"The assumption that delimiters are ≥4 chars and the first char determines the type is an AsciiDoc parsing rule."}]},{"attributes":[],"level":3,"text":"1C. `delimiter_to_semantic_type` in BlockBuilder — DUPLICATE of 1A"},{"attributes":[],"text":"`lib/ceradoc/core_model/builder/block_builder.rb:45-58`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/builder/block_builder.rb:45-58"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"def delimiter_to_semantic_type(delimiter)\n  return nil unless delimiter && !delimiter.empty?\n  char = delimiter[0]\n  case char\n  when '-' then :source_code\n  when '=' then :example\n  when '_' then :quote\n  when '*' then :sidebar\n  when '.' then :literal\n  when '+' then :pass\n  else nil\n  end\nend"},{"attributes":[],"text":"Same mapping, different implementation — duplicated within CoreModel itself.","children":[{"attributes":[],"content":"Same mapping, different implementation — duplicated within CoreModel itself."}]},{"attributes":[],"level":3,"text":"1D. `delimiter_type` attribute — DEPRECATED but still used"},{"attributes":[],"text":"`lib/ceradoc/core_model/block.rb:90-93`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/block.rb:90-93"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"# DEPRECATED — use block_semantic_type. Retained for backward compatibility.\nattribute :delimiter_type, :string"},{"attributes":[],"text":"Still read by `resolve_semantic_from_delimiter` at line 126.","children":[{"attributes":[],"content":"Still read by "},{"attributes":[],"text":"resolve_semantic_from_delimiter"},{"attributes":[],"content":" at line 126."}]},{"attributes":[],"level":3,"text":"1E. `delimiter_length` attribute — AsciiDoc convention"},{"attributes":[],"text":"`lib/ceradoc/core_model/block.rb:95-97`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/block.rb:95-97"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"attribute :delimiter_length, :integer, default: -> { 4 }"},{"attributes":[],"text":"\"Number of delimiter characters\" defaulting to 4 is the AsciiDoc convention.","children":[{"attributes":[],"content":"\"Number of delimiter characters\" defaulting to 4 is the AsciiDoc convention."}]},{"attributes":[],"level":3,"text":"1F. BlockBuilder sets `delimiter_length`"},{"attributes":[],"text":"`lib/ceradoc/core_model/builder/block_builder.rb:20,35`:","children":[{"attributes":[],"text":"lib/ceradoc/core_model/builder/block_builder.rb:20,35"},{"attributes":[],"content":":"}]},{"attributes":[],"language":"ruby","code":"delimiter_length: ast[:delimiter]&.to_s&.length || 4,"},{"attributes":[],"level":2,"text":"Fix"},{"attributes":[],"ordered":true,"items":[{"attributes":[],"text":"Remove `DELIMITER_CHAR_TO_SEMANTIC`, `resolve_semantic_from_delimiter`, `delimiter_type`, `delimiter_length` from `CoreModel::Block`.","children":[{"attributes":[],"content":"Remove "},{"attributes":[],"text":"DELIMITER_CHAR_TO_SEMANTIC"},{"attributes":[],"content":", "},{"attributes":[],"text":"resolve_semantic_from_delimiter"},{"attributes":[],"content":", "},{"attributes":[],"text":"delimiter_type"},{"attributes":[],"content":", "},{"attributes":[],"text":"delimiter_length"},{"attributes":[],"content":" from "},{"attributes":[],"text":"CoreModel::Block"},{"attributes":[],"content":"."}]},{"attributes":[],"text":"Remove `delimiter_to_semantic_type` from `BlockBuilder`.","children":[{"attributes":[],"content":"Remove "},{"attributes":[],"text":"delimiter_to_semantic_type"},{"attributes":[],"content":" from "},{"attributes":[],"text":"BlockBuilder"},{"attributes":[],"content":"."}]},{"attributes":[],"text":"Move all delimiter-to-semantics mapping to `ceradoc-adoc`'s ToCoreModel transformer, which should resolve the semantic type before constructing CoreModel objects.","children":[{"attributes":[],"content":"Move all delimiter-to-semantics mapping to "},{"attr