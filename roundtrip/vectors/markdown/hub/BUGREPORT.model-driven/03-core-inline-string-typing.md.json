ent","children":[],"content":"CoreModel::InlineElement"},{"type":"TextContent","text":" uses a "},{"type":"MonospaceElement","children":[],"content":"format_type"},{"type":"TextContent","text":" string attribute ("},{"type":"MonospaceElement","children":[],"content":"'bold'"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"'italic'"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"'monospace'"},{"type":"TextContent","text":") to distinguish inline types, while "},{"type":"MonospaceElement","children":[],"content":"Block"},{"type":"TextContent","text":" correctly uses typed subclasses ("},{"type":"MonospaceElement","children":[],"content":"SourceBlock < Block"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"QuoteBlock < Block"},{"type":"TextContent","text":"). This architectural inconsistency forces every consumer to use "},{"type":"MonospaceElement","children":[],"content":"case format_type"},{"type":"TextContent","text":" instead of polymorphic dispatch."}],"content":"`CoreModel::InlineElement` uses a `format_type` string attribute (`'bold'`, `'italic'`, `'monospace'`) to distinguish inline types, while `Block` correctly uses typed subclasses (`SourceBlock < Block`, `QuoteBlock < Block`). This architectural inconsistency forces every consumer to use `case format_type` instead of polymorphic dispatch.","callouts":[]},{"type":"ParagraphBlock","children":[{"type":"TextContent","text":"Additionally, the "},{"type":"MonospaceElement","children":[],"content":"constrained"},{"type":"TextContent","text":" attribute on "},{"type":"MonospaceElement","children":[],"content":"InlineElement"},{"type":"TextContent","text":" is an AsciiDoc-only concept."}],"content":"Additionally, the `constrained` attribute on `InlineElement` is an AsciiDoc-only concept.","callouts":[]},{"type":"SectionElement","title":"Evidence","level":2,"children":[]},{"type":"SectionElement","title":"3A. String-based `format_type` with divergent type lists","level":3,"children":[]},{"type":"ParagraphBlock","children":[{"type":"MonospaceElement","children":[],"content":"lib/ceradoc/core_model/inline_element.rb:49-61"},{"type":"TextContent","text":":"}],"content":"`lib/ceradoc/core_model/inline_element.rb:49-61`:","callouts":[]},{"type":"SourceBlock","children":[],"content":"FORMAT_TYPES = %w[\n  bold italic monospace underline strikethrough\n  subscript superscript highlight\n  link xref stem footnote\n  hard_line_break\n].freeze\n\nattribute :format_type, :string","language":"ruby","callouts":[]},{"type":"ParagraphBlock","children":[{"type":"TextContent","text":"The Builder's "},{"type":"MonospaceElement","children":[],"content":"Detection#inline_format_types"},{"type":"TextContent","text":" ("},{"type":"MonospaceElement","children":[],"content":"builder/detection.rb:178-183"},{"type":"TextContent","text":") defines a DIFFERENT list:"}],"content":"The Builder's `Detection#inline_format_types` (`builder/detection.rb:178-183`) defines a DIFFERENT list:","callouts":[]},{"type":"SourceBlock","children":[],"content":"%i[bold italic monospace superscript subscript highlight span link\n   cross_reference bold_constrained bold_unconstrained\n   italic_constrained italic_unconstrained monospace_constrained\n   monospace_unconstrained]","language":"ruby","callouts":[]},{"type":"ParagraphBlock","children":[{"type":"TextContent","text":"Divergence:"}],"content":"Divergence:","callouts":[]},{"type":"ListBlock","marker_type":"unordered","items":[{"type":"ListItem","children":[{"type":"MonospaceElement","children":[],"content":"FORMAT_TYPES"},{"type":"TextContent","text":" has: "},{"type":"MonospaceElement","children":[],"content":"underline"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"strikethrough"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"xref"},{"type":"TextContent","text":",