":"ListItem","children":[{"type":"MonospaceElement","children":[],"content":"ceradoc-adoc/lib/ceradoc/asciidoc/transform/from_core_model.rb:225-260"},{"type":"TextContent","text":" — 15-case chain"}],"marker":"*","content":"`ceradoc-adoc/lib/ceradoc/asciidoc/transform/from_core_model.rb:225-260` — 15-case chain"},{"type":"ListItem","children":[{"type":"MonospaceElement","children":[],"content":"ceradoc-markdown/lib/ceradoc/markdown/transform/from_core_model.rb:172-206"},{"type":"TextContent","text":" — 15-case chain"}],"marker":"*","content":"`ceradoc-markdown/lib/ceradoc/markdown/transform/from_core_model.rb:172-206` — 15-case chain"},{"type":"ListItem","children":[{"type":"MonospaceElement","children":[],"content":"ceradoc-docx/lib/ceradoc/docx/transform/from_core_model.rb:43-57"},{"type":"TextContent","text":" — catches all InlineElement then re-dispatches"}],"marker":"*","content":"`ceradoc-docx/lib/ceradoc/docx/transform/from_core_model.rb:43-57` — catches all InlineElement then re-dispatches"}]},{"type":"SectionElement","title":"3C. `constrained` attribute — AsciiDoc-only concept","level":3,"children":[]},{"type":"ParagraphBlock","children":[{"type":"MonospaceElement","children":[],"content":"lib/ceradoc/core_model/inline_element.rb:63-66"},{"type":"TextContent","text":":"}],"content":"`lib/ceradoc/core_model/inline_element.rb:63-66`:","callouts":[]},{"type":"SourceBlock","children":[],"content":"# whether the formatting uses constrained syntax (true for *text*, false for **text**)\nattribute :constrained, :boolean, default: -> { true }","language":"ruby","callouts":[]},{"type":"ParagraphBlock","children":[{"type":"TextContent","text":"Constrained/unconstrained is uniquely AsciiDoc. Markdown uses "},{"type":"MonospaceElement","children":[],"content":"*"},{"type":"TextContent","text":" vs "},{"type":"MonospaceElement","children":[],"content":"**"},{"type":"TextContent","text":" for italic vs bold — a different semantic. HTML has no such concept."}],"content":"Constrained/unconstrained is uniquely AsciiDoc. Markdown uses `*` vs `**` for italic vs bold — a different semantic. HTML has no such concept.","callouts":[]},{"type":"SectionElement","title":"3D. Builder detection of `_constrained`/`_unconstrained` AST keys","level":3,"children":[]},{"type":"ParagraphBlock","children":[{"type":"MonospaceElement","children":[],"content":"lib/ceradoc/core_model/builder/detection.rb:126-153"},{"type":"TextContent","text":":"}],"content":"`lib/ceradoc/core_model/builder/detection.rb:126-153`:","callouts":[]},{"type":"SourceBlock","children":[],"content":"def detect_inline_format(ast)\n  ast.each_key do |key|\n    key_str = key.to_s\n    return key_str if key_str.end_with?('_constrained', '_unconstrained')\n  end\nend\n\ndef detect_constrained(ast, format_type)\n  if format_type.end_with?('_constrained')\n    return true\n  elsif format_type.end_with?('_unconstrained')\n    return false\n  end\nend","language":"ruby","callouts":[]},{"type":"ParagraphBlock","children":[{"type":"TextContent","text":"These AST key names are artifacts of the AsciiDoc parser's AST structure."}],"content":"These AST key names are artifacts of the AsciiDoc parser's AST structure.","callouts":[]},{"type":"SectionElement","title":"Fix","level":2,"children":[]},{"type":"ListBlock","marker_type":"ordered","items":[{"type":"ListItem","children":[{"type":"TextContent","text":"Create typed InlineElement subclasses matching the Block pattern: "},{"type":"MonospaceElement","children":[],"content":"BoldElement"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"ItalicElement"},{"type":"TextContent","text":", "},{"type":"MonospaceElement","children":[],"content":"LinkElement"},{"type":"TextContent","text":", etc."}],"marker":"1.","content":"Create typed InlineElement subclasses matching the Block pattern: `BoldElement`, `ItalicElement`, `LinkElement`, etc."},{"type":"ListItem","children":[{"type":"TextContent","text":"Move "},{"type":"MonospaceElement","children":[],"content":"constrained"},{"type":"TextContent","text":" to the AsciiDoc format gem's own inline model."}],"marker":"1.","content":"Move `constrained` to the AsciiDoc format gem's own inline model."},{"type":"ListItem","children":[{"type":"TextContent","text":"Consolidate the two divergent type lists into a single canonical source."}],"marker":"1.","content":"Consolidate the two divergent type lists into a single canonical source."},{"type":"ListItem","children":[{"type":"TextContent","text":"Transformers use class-based dispatch ("},{"type":"MonospaceElement","children":[],"content":"when Ceradoc::CoreModel::BoldElement"},{"type":"TextContent","text":") instead of string matching."}],"marker":"1.","content":"Transformers use class-based dispatch (`when Ceradoc::CoreModel::BoldElement`) instead of string matching."}]}]}