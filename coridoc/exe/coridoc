#!/usr/bin/env ruby
# frozen_string_literal: true

lib_path = File.expand_path('../lib', __dir__)
$LOAD_PATH.unshift(lib_path) unless $LOAD_PATH.include?(lib_path)

require 'coridoc'
require 'coridoc/cli'

GEM_TO_REQUIRE_PATH = {
  'coridoc-adoc' => 'coridoc/asciidoc',
  'coridoc-html' => 'coridoc/html',
  'coridoc-markdown' => 'coridoc/markdown',
  'coridoc-docx' => 'coridoc/docx'
}.freeze

GEM_TO_REQUIRE_PATH.each do |gem_name, require_path|
  gem gem_name
  require require_path
rescue LoadError
  nil
end

Coridoc::CLI.start(ARGV)
